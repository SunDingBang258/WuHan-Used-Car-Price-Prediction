# 复制成 .env 后填写(本地开发用; 生产请由部署环境注入)。
# 下面的 DB_* 没有兜底默认值, 缺了程序会直接启动失败并提示缺哪几项。

APP_NAME=武汉二手车价格预测
DEBUG=false
# 启动时自动建表(生产建议用迁移工具, 设为 false)
AUTO_CREATE_TABLES=true

# ---- MySQL: 宿主机直连(uvicorn 直接跑, 或连你本机已装的 MySQL) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=utf8mb4

# 也可以直接给一条完整连接串; 设了它就忽略上面的分项
# DATABASE_URL=mysql+pymysql://用户:密码@127.0.0.1:3306/库名?charset=utf8mb4

# ---- MySQL: docker-compose 用(容器内的那一套) ----
# 和上面的 DB_* 是两回事: 容器里应用连的是服务名 mysql, 用户是普通账号而不是 root。
# 不填则用 docker-compose.yml 里的默认值(root / car_predict / carpredict)。
# MYSQL_ROOT_PASSWORD=root
# MYSQL_DATABASE=car_predict
# MYSQL_USER=carpredict
# MYSQL_PASSWORD=carpredict

# ---- 可选: 让 docker-compose 直接跑 CI 推上去的镜像(替代本地 build) ----
# DOCKERHUB_USERNAME=你的dockerhub用户名

# ---- 训练脚本 ml/train.py 用 ----
# 设了它就把实验记录到 DagsHub; 不设则退回到本地 SQLite (mlflow.db)
# DAGSHUB_USER_TOKEN=你的token

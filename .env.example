# 复制成 .env 后填写(本地开发用; 生产请由部署环境注入)。
# 下面的 DB_* 没有兜底默认值, 缺了程序会直接启动失败并提示缺哪几项。

APP_NAME=武汉二手车价格预测
DEBUG=false
# 启动时自动建表(生产建议用迁移工具, 设为 false)
AUTO_CREATE_TABLES=true

# ---- MySQL(必填) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=utf8mb4

# 也可以直接给一条完整连接串; 设了它就忽略上面的分项
# DATABASE_URL=mysql+pymysql://用户:密码@127.0.0.1:3306/库名?charset=utf8mb4
